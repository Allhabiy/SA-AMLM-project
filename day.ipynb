import importlib.metadata as metadata
import os
import signal
import subprocess
import sys

EXPECTED_VERSIONS = {
    "numpy": "2.1.3",
    "pandas": "2.2.3",
    "scipy": "1.16.3",
    "scikit-learn": "1.6.1",
    "matplotlib": "3.10.0",
    "xgboost": "3.4.1",
    "lightgbm": "4.6.0",
    "shap": "0.52.0",
    "numba": "0.61.2",
    "optuna": "4.5.0",
}

different_versions = []

for package_name, expected_version in EXPECTED_VERSIONS.items():
    try:
        current_version = metadata.version(package_name)
    except metadata.PackageNotFoundError:
        current_version = None

    if current_version != expected_version:
        different_versions.append(
            f"{package_name}: {current_version or 'غير مثبت'} → {expected_version}"
        )

if different_versions:
    print("سيتم تجهيز بيئة الدورة بالإصدارات المعتمدة:")
    for item in different_versions:
        print("-", item)

    requirements_url = (
        "https://raw.githubusercontent.com/"
        "almiyead-rgb/sda-dsc-211-student-template/"
        "fe0c0204e6076a7ac2139b7336485a097343fb8a/"
        "requirements-colab.txt"
    )

    constraints_url = (
        "https://raw.githubusercontent.com/"
        "almiyead-rgb/sda-dsc-211-student-template/"
        "fe0c0204e6076a7ac2139b7336485a097343fb8a/"
        "constraints.txt"
    )

    subprocess.check_call([
        sys.executable,
        "-m",
        "pip",
        "install",
        "--quiet",
        "--disable-pip-version-check",
        "-r",
        requirements_url,
        "-c",
        constraints_url,
    ])

    print(
        "\nتم تثبيت بيئة الدورة بنجاح.\n"
        "ستتم إعادة تشغيل الجلسة الآن بصورة تلقائية.\n"
        "بعد عودة الاتصال اختَر Runtime → Run all مرة أخرى."
    )

    os.kill(os.getpid(), signal.SIGKILL)

else:
    print("بيئة الدورة جاهزة، ويمكن متابعة تشغيل Notebook.")
